# ==============================================================================
# t3code-docker 环境变量配置模板 (.env.example)
# ==============================================================================

# 统一对外访问端口（T3 WebUI、/admin 管理后台与 /vnc 桌面共用此单端口）
PROXY_PORT=3080

# 管理员初始访问口令（推荐留空！）
# - 留空：首次打开网页会自动进入「初始化设密向导」，口令以 scrypt 高强度哈希落盘至 /data/gateway
# - 填写：跳过向导直接使用该初始口令（读取后将立即从网关内存 env 中销毁，防止泄漏给子进程）
AUTH_TOKEN=

# 自定义网关管理后台与虚拟桌面路径（登录后亦可在后台随时免重启热修改）
ADMIN_PATH=/admin
VNC_PATH=/vnc

# 宿主机文件属主映射（使 /workspace 下 AI 生成的代码文件属主与宿主机当前用户一致）
PUID=1000
PGID=1000
TZ=Asia/Shanghai

# 首次启动自动安装到持久化卷的编码 Agent 策略：
# - core : 默认安装 Claude Code、Codex、OpenCode
# - all  : 安装全部内置目录支持的 Agent CLI
# - none : 不预装，进入后台按需一键安装
T3_PREINSTALL=core

# 反向代理与外部域名设置（部署在 Nginx / Caddy / Cloudflare Tunnel 后方时启用）
TRUST_PROXY=0
PUBLIC_URL=

# 工作平面出站网络代理（可选，也可在后台可视化修改）
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1
